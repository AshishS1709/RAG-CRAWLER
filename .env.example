# ============================================================
# RAG Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# Groq API Key (required — for chat/generation LLM)
# Get yours free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# NOTE: No API key needed for embeddings!
# The nomic-ai/nomic-embed-text-v1 model runs locally via HuggingFace.
# It will be downloaded (~274 MB) on first run and cached automatically.

# --- Model Configuration (optional overrides) ---
# Groq chat models (pick one):
#   llama-3.1-8b-instant   → fastest,  cheapest  ($0.05/$0.08 per 1M tokens)
#   llama-3.3-70b-versatile → smarter, still fast ($0.59/$0.79 per 1M tokens)
#   mixtral-8x7b-32768     → balanced             ($0.24/$0.24 per 1M tokens)
CHAT_MODEL=llama-3.1-8b-instant
# EMBEDDING_MODEL is not needed — embeddings use local nomic-ai/nomic-embed-text-v1 ($0 cost)

# --- Crawler Settings (optional overrides) ---
TARGET_URL=https://docs.python.org/3/
MAX_PAGES=80
MAX_DEPTH=3
CRAWL_DELAY=0.5   # seconds between requests

# --- Vector Store (optional overrides) ---
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=python_docs

# --- Retrieval (optional overrides) ---
TOP_K=6
CHUNK_SIZE=800
CHUNK_OVERLAP=150
