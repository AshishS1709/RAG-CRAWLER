# ============================================================
# RAG Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# Groq API Key (required — for chat/generation LLM)
# Get yours free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# NOTE: No API key needed for embeddings!
# The BAAI/bge-small-en-v1.5 model runs locally via HuggingFace / SentenceTransformers.
# It will be downloaded (~133 MB) on first run and cached automatically.

# --- Model Configuration (optional overrides) ---
# Groq chat models (pick one):
#   openai/gpt-oss-20b  → fastest,  cheapest ($0.075/$0.30 per 1M tokens)
#   openai/gpt-oss-120b → smarter,  higher capacity ($0.150/$0.60 per 1M tokens)
#   qwen/qwen3.6-27b    → balanced alternative ($0.200/$0.60 per 1M tokens)
GROQ_MODEL=openai/gpt-oss-20b
CHAT_MODEL=openai/gpt-oss-20b
# EMBEDDING_MODEL is not needed — embeddings use local BAAI/bge-small-en-v1.5 ($0 cost)

# --- Crawler Settings (optional overrides) ---
TARGET_URL=https://docs.python.org/3/
MAX_PAGES=80
MAX_DEPTH=3
CRAWL_DELAY=0.5   # seconds between requests

# --- Vector Store (optional overrides) ---
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=python_docs

# --- Retrieval (optional overrides) ---
TOP_K=6
CHUNK_SIZE=800
CHUNK_OVERLAP=150
